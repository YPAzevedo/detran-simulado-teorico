# Refuse to install package versions younger than 7 days (in minutes).
# Cushion against fresh malicious publishes from compromised maintainers.
minimum-release-age=10080

# Verify node_modules matches the lockfile before running any script.
verify-deps-before-run=error

# Block dependency install/postinstall scripts unless allowlisted in
# package.json#pnpm.onlyBuiltDependencies (currently empty).
strict-dep-builds=true

# Refuse `pnpm install` if pnpm-lock.yaml would change.
frozen-lockfile=true
